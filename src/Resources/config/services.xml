<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="AltTextGeneratorAI\Service\ImagePreparer"/>

        <service id="AltTextGeneratorAI\Service\AltTextClient">
            <argument type="service" id="http_client"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="AltTextGeneratorAI\Service\MediaAltTextService">
            <argument type="service" id="media.repository"/>
            <argument type="service" id="shopware.filesystem.public"/>
            <argument type="service" id="shopware.filesystem.private"/>
            <argument type="service" id="AltTextGeneratorAI\Service\ImagePreparer"/>
            <argument type="service" id="AltTextGeneratorAI\Service\AltTextClient"/>
        </service>

        <service id="AltTextGeneratorAI\Controller\AltTextController" public="true">
            <argument type="service" id="AltTextGeneratorAI\Service\MediaAltTextService"/>
            <argument type="service" id="AltTextGeneratorAI\Service\AltTextClient"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="AltTextGeneratorAI\Subscriber\MediaUploadedSubscriber">
            <argument type="service" id="AltTextGeneratorAI\Service\AltTextClient"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="AltTextGeneratorAI\MessageHandler\GenerateAltTextHandler">
            <argument type="service" id="AltTextGeneratorAI\Service\MediaAltTextService"/>
            <argument type="service" id="AltTextGeneratorAI\Service\AltTextClient"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
